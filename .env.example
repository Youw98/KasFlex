# Copy to .env (git-ignored) or set in the environment. Never commit real values.
# The settings menu (⚙, password-protected) can also save the API keys for you.

# Day-ahead electricity prices (https://transparency.entsoe.eu/)
ENTSOE_API_KEY=

# AI service for explanations and chat: set the one you use, leave the rest empty.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
# OPENAI_BASE_URL=
# OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_COMPATIBLE_BASE_URL=

# Password for settings, research data and the workshop admin page (default admin99).
KASFLEX_ADMIN_PASSWORD=

# Where results, memory and settings are written (default: the current folder).
# KASFLEX_HOME=
